include(FetchContent)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyFixes.cmake")
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
# Keep raylib's normal frame control, but let the OS sleep for the entire
# frame wait instead of spending its tail polling the clock on the CPU.
set(CUSTOMIZE_BUILD ON CACHE BOOL "" FORCE)
set(SUPPORT_BUSY_WAIT_LOOP OFF CACHE BOOL "" FORCE)
set(SUPPORT_PARTIALBUSY_WAIT_LOOP OFF CACHE BOOL "" FORCE)
if(WIN32)
  set(SUPPORT_FILEFORMAT_BMP ON CACHE BOOL "" FORCE)
endif()
set(STORM_USE_BUNDLED_LIBRARIES ON CACHE BOOL "" FORCE)
set(STORM_SKIP_INSTALL ON CACHE BOOL "" FORCE)
foreach(dep IN ITEMS raylib stormlib)
  if(EXISTS "${CMAKE_SOURCE_DIR}/external/${dep}/CMakeLists.txt")
    d2x_prepare_dependency("${dep}" "${CMAKE_SOURCE_DIR}/external/${dep}")
    add_subdirectory(external/${dep} EXCLUDE_FROM_ALL)
  elseif(dep STREQUAL "raylib")
    FetchContent_Declare(raylib GIT_REPOSITORY https://github.com/raysan5/raylib.git GIT_TAG c1ab645ca298a2801097931d1079b10ff7eb9df8 SOURCE_SUBDIR d2x-no-upstream-build)
    FetchContent_MakeAvailable(raylib)
    d2x_prepare_dependency(raylib "${raylib_SOURCE_DIR}")
    add_subdirectory("${raylib_SOURCE_DIR}" "${raylib_BINARY_DIR}" EXCLUDE_FROM_ALL)
  else()
    FetchContent_Declare(stormlib GIT_REPOSITORY https://github.com/ladislav-zezula/StormLib.git GIT_TAG 86f9b99ffe4d3417dad16d00541cf6f2e3d7bf79 SOURCE_SUBDIR d2x-no-upstream-build)
    FetchContent_MakeAvailable(stormlib)
    d2x_prepare_dependency(stormlib "${stormlib_SOURCE_DIR}")
    add_subdirectory("${stormlib_SOURCE_DIR}" "${stormlib_BINARY_DIR}" EXCLUDE_FROM_ALL)
  endif()
endforeach()
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
FetchContent_Declare(nlohmann_json
  URL https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz
  URL_HASH SHA256=d6c65aca6b1ed68e7a182f4757257b107ae403032760ed6ef121c9d55e81757d)
FetchContent_MakeAvailable(nlohmann_json)
